    {
        "id": "cec6c6f9eaf86ab4",
        "type": "function",
        "z": "c328be5208bddb2e",
        "name": "function 1",
        "func": "let data;\n\n// 1. 들어온 데이터가 문자열(JSON 텍스트)이면 오브젝트로 파싱\nif (typeof msg.payload === \"string\") {\n    try {\n        data = JSON.parse(msg.payload);\n    } catch(e) {\n        node.error(\"JSON 파싱 실패: \" + e.message);\n        return null;\n    }\n} else {\n    data = msg.payload;\n}\n\n// 2. 클라이언트가 보낸 base64 이미지 데이터 추출\nlet rawBase64 = data.image;\n\nif (!rawBase64) {\n    node.error(\"데이터에 image 필드가 없습니다.\");\n    return null;\n}\n\n// 3. HTTP POST 요청을 위한 헤더 설정\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\n// 4. Flask 서버가 인식할 수 있는 최종 JSON 바디 구성\n// 앞에 'data:image/jpeg;base64,'를 붙여서 넘겨줍니다.\nmsg.payload = {\n    \"image\": \"data:image/jpeg;base64,\" + rawBase64\n};\n\nreturn msg;",
